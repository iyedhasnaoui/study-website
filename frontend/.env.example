# Copy to .env.production.local (or set in your host's build environment) and adjust.
# Vite inlines these at BUILD time, so rebuild after changing them.

# Base URL of the Spring Boot backend, no trailing slash. Default: http://localhost:8080
VITE_API_BASE_URL=https://api.example.com

# Keycloak server, realm and public client. Defaults: http://localhost:8081, iac, iac-frontend
VITE_KEYCLOAK_URL=https://auth.example.com
VITE_KEYCLOAK_REALM=iac
VITE_KEYCLOAK_CLIENT_ID=iac-frontend
